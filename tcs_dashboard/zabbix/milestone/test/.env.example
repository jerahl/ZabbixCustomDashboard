# Phase 0 dev-harness configuration — copy to .env and fill in.
# .env is gitignored (see .gitignore in this dir); never commit real creds.
#
# A dedicated read-only XProtect Basic user is sufficient for the config GETs
# and the WS events/state subscription. Use the DEV API Gateway, not prod.

MILESTONE_HOST=dev-xprotect.example.com
MILESTONE_SCHEME=https
MILESTONE_USER=zbx_probe
MILESTONE_PASSWORD=changeme
MILESTONE_CLIENT_ID=GrantValidatorClient

# Set to 1 to enforce TLS cert validation. Leave 0 for self-signed dev certs.
MILESTONE_VERIFY_TLS=0
